{
  "name": "rota-webmcp",
  "private": true,
  "version": "1.0.0",
  "description": "Rota \u2014 an agent-collaborative shift scheduling studio built on WebMCP. The agent does the grind; the human stays in charge.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "tools:doc": "esbuild scripts/gen-tools-doc.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/gendoc.mjs --log-level=error && node node_modules/.tmp/gendoc.mjs",
    "selftest": "esbuild scripts/selftest.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/selftest.mjs --log-level=error && node node_modules/.tmp/selftest.mjs",
    "smoke": "node scripts/smoke.mjs",
    "agent-test": "node scripts/agent-test.mjs",
    "shots": "node scripts/shots.mjs",
    "video": "node scripts/make-video.mjs",
    "video:fast": "node scripts/make-video.mjs --fast"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "ffmpeg-static": "^5.3.0",
    "puppeteer-core": "^24.43.1",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "webmcp-types": "^0.1.6"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}